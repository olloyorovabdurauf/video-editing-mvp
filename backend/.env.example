# Copy to .env and fill in

# --- App ---
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI providers ---
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_REASONING_MODEL=gpt-4o

# --- Stock footage ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Generative video providers (any or all; registry auto-disables empty) ---
RUNWAY_API_KEY=
HIGGSFIELD_API_KEY=
MAX_AI_BROLL_BUDGET_USD=8.0

# --- Billing ---
# Empty in dev; required in prod. With STRIPE_WEBHOOK_SECRET unset the
# webhook handler accepts unverified events (DO NOT ship to prod like this).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
REQUIRE_CREDITS=false

# --- Storage (local for dev, S3 for prod) ---
STORAGE_BACKEND=local        # local | s3
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=             # for MinIO / R2
S3_PUBLIC_BASE_URL=          # CDN or public-bucket URL (e.g. https://cdn.example.com)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Auth (production) ---
# none = trust X-User-Id (DEV ONLY — refuses to start with APP_ENV=production)
# clerk = verify Clerk-issued JWTs
# custom = your own IDP (provide CUSTOM_AUTH_JWKS_URL)
AUTH_MODE=none
CLERK_JWKS_URL=
CUSTOM_AUTH_JWKS_URL=

# --- Observability ---
SENTRY_DSN=                  # empty = disabled (no-op)

# --- Production knobs ---
CORS_ORIGINS=http://localhost:3000     # comma-separated. Lock down in prod.
RATE_LIMIT_REELS_PER_MIN=10
RATE_LIMIT_REELS_WINDOW_S=60

# --- FFmpeg ---
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_THREADS=0             # 0 = auto
FFMPEG_HWACCEL=              # e.g. cuda, videotoolbox; empty = software
